{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gh-traffic-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  // No top-level account_id: wrangler uses whichever account you're logged
  // into (or prompts you to pick one, if you have several).
  "vars": {
    "NOTIFY_EMAIL": "REPLACE_WITH_YOUR_EMAIL",
    "NOTIFY_FROM_EMAIL": "onboarding@resend.dev"
  },
  // Which repos get polled is config in D1 (tracked_repos table), not a var
  // here — see README.md. Add repos with wrangler d1 execute.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gh-traffic-tracker",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    // Once a day — GitHub's traffic API is daily-granular anyway, polling
    // more often than that just re-reads the same numbers.
    "crons": ["0 6 * * *"]
  }
}
